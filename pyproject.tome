[project]
name = "ai-3"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
    "torch>=2.0.0",
    "torchvision>=0.15.0",
    "flask>=3.0.0",
    "flask-cors>=4.0.0",
    "gunicorn>=21.2.0",
    "pillow>=10.0.0",
    "opencv-python-headless>=4.8.0",
    "numpy>=1.24.0",
    "qrcode>=7.4.2",
    "requests>=2.31.0",
]

[tool.uv.sources]
torch = { index = "pytorch-cpu" }
torchvision = { index = "pytorch-cpu" }

[[tool.uv.index]]
name = "pytorch-cpu"
url = "https://download.pytorch.org/whl/cpu"
explicit = true
